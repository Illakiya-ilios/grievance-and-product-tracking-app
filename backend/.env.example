# Copy to .env (project root or backend/). Everything is optional for local development.
ENV=dev
# SQLite is the default and the supported setup.
DATABASE_URL=sqlite:///./tasmac.db
# Required when ENV is not "dev"
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# One Gemini key for analysis and embeddings. Leave empty to use the local heuristic providers.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Optional threshold overrides (cosine similarity)
# DUPLICATE_THRESHOLD=0.95
# RELATED_THRESHOLD=0.84

# Seed accounts (python -m app.seed)
# SEED_PASSWORD=

# Show the 'Demo data' notice on the Find stores page (stock is synthetic until a real feed exists)
STORE_DATA_IS_SAMPLE=true
